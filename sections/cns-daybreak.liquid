{%- comment -%}
  Club No Sleep — solopgangen.

  Overgangen fra nat til morgen. Ikke én farveovergang, men fire lag,
  som cns.css lægger oven på hinanden:

    1. et meget svagt skær, der stiger op nedefra
    2. himlen, med tretten farvetrin, så der ikke opstår bånd
    3. et kornlag, der holder bånd væk på telefonskærme
    4. de sidste stjerner øverst, tonet ud af en maske

  Værdierne er finjusterede. Små ændringer ødelægger blødheden — derfor
  er kun højden, den øverste farve og stjernerne til at røre ved.
{%- endcomment -%}

{% render 'cns-palette', id: section.id, bg: section.settings.cns_bg %}

{% style %}
  #cns-{{ section.id }} {
    height: clamp(300px, 40vw, {{ section.settings.height }}px);
  }
{% endstyle %}

<div id="cns-{{ section.id }}" class="cns cns-daybreak" aria-hidden="true">
  {%- if section.settings.show_stars -%}
    <canvas
      class="cns-starfield__canvas cns-stars"
      data-cns-canvas="stars"
      data-cns-count="{{ section.settings.star_count }}"
      data-cns-dim="{{ section.settings.star_dim }}"
      data-cns-spread="0.6"
      aria-hidden="true"
    ></canvas>
  {%- endif -%}
</div>

{%- if section.settings.show_stars -%}
  <script src="{{ 'cns-lights.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "CNS solopgang",
  "tag": "div",
  "class": "cns-daybreak-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Himlen, der lysner fra nat til morgen. Placér den dér, hvor siden skal skifte."
    },
    {
      "type": "select",
      "id": "cns_bg",
      "label": "Baggrund",
      "info": "Den øverste farve. Vælg den samme som sektionen ovenfor, så overgangen bliver usynlig.",
      "options": [
        { "value": "nat", "label": "Nat" },
        { "value": "dyb-nat", "label": "Dyb nat" },
        { "value": "morgen", "label": "Morgen" },
        { "value": "lys-morgen", "label": "Lys morgen" }
      ],
      "default": "nat"
    },
    {
      "type": "range",
      "id": "height",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "label": "Højde",
      "info": "Højden på store skærme. På små skærme skrumper den af sig selv.",
      "default": 460
    },
    {
      "type": "header",
      "content": "Stjernerne"
    },
    {
      "type": "paragraph",
      "content": "De sidste stjerner øverst, som går ud i takt med at himlen lysner."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Vis stjernerne",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "min": 0,
      "max": 60,
      "step": 2,
      "label": "Antal stjerner",
      "default": 14
    },
    {
      "type": "range",
      "id": "star_dim",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "label": "Styrke",
      "default": 0.45
    }
  ],
  "presets": [
    {
      "name": "CNS solopgang"
    }
  ]
}
{% endschema %}
