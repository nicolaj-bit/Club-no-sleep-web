{%- comment -%}
  Club No Sleep — partner.
  Tekst til venstre, et kort med kontoens brugere til højre.
{%- endcomment -%}

{% render 'cns-palette', id: section.id, bg: section.settings.cns_bg %}

<section
  id="cns-{{ section.id }}"
  class="cns cns-section cns-space--{{ section.settings.cns_space }} cns-partner cns-bg--{{ section.settings.cns_bg }}{% if section.settings.show_stars %} cns-starfield{% endif %}"
>
  {%- comment -%}
    Canvasset er første barn, så feltet ligger bagest. Indholdet nedenfor
    ligger i .cns-wrap, som starfield-reglen løfter op over det.
  {%- endcomment -%}
  {%- if section.settings.show_stars -%}
    <canvas
      class="cns-starfield__canvas cns-stars{% if section.settings.star_mask != 'ingen' %} cns-starfield__canvas--{{ section.settings.star_mask }} cns-stars--{{ section.settings.star_mask }}{% endif %}"
      data-cns-canvas="stars"
      data-cns-count="{{ section.settings.star_count }}"
      data-cns-spread="{{ section.settings.star_spread | divided_by: 100.0 }}"
      data-cns-dim="{{ section.settings.star_dim | divided_by: 100.0 }}"
      data-cns-halo="{{ section.settings.star_halo | divided_by: 100.0 }}"
      aria-hidden="true"
    ></canvas>
  {%- endif -%}

  {%- if section.settings.cns_anchor != blank -%}
    <span class="cns-anchor" id="{{ section.settings.cns_anchor | handle }}"></span>
  {%- endif -%}

  <div class="cns-wrap">
    {%- if section.settings.hour != blank -%}
      <p class="cns-hour">{{ section.settings.hour }}</p>
    {%- endif -%}

    <div class="cns-pair">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="cns-lede cns-rte cns-body">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="cns-invite" aria-hidden="true">
          {%- for block in section.blocks -%}
            <div class="cns-who" {{ block.shopify_attributes }}>
              {%- if block.type == 'invite' -%}
                <div class="cns-circle cns-circle--empty">+</div>
                <div class="cns-nm cns-nm--muted">{{ block.settings.label }}</div>
              {%- else -%}
                {%- liquid
                  assign initial = block.settings.initial
                  if initial == blank
                    assign initial = block.settings.name | slice: 0, 1
                  endif
                -%}
                <div class="cns-circle">{{ initial | upcase }}</div>
                <div class="cns-nm">
                  {{- block.settings.name -}}
                  {%- if block.settings.role != blank -%}
                    <span>{{ block.settings.role }}</span>
                  {%- endif -%}
                </div>
                {%- if block.settings.status != blank -%}
                  <span class="cns-pill">{{ block.settings.status }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_stars -%}
  <script src="{{ 'cns-lights.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "CNS partner",
  "tag": "section",
  "class": "cns-partner-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "cns_bg",
      "label": "Baggrund",
      "options": [
        { "value": "nat", "label": "Nat" },
        { "value": "dyb-nat", "label": "Dyb nat" },
        { "value": "morgen", "label": "Morgen" },
        { "value": "lys-morgen", "label": "Lys morgen" }
      ],
      "default": "nat"
    },
    {
      "type": "select",
      "id": "cns_space",
      "label": "Afstand foroven og forneden",
      "options": [
        { "value": "kompakt", "label": "Kompakt" },
        { "value": "standard", "label": "Standard" },
        { "value": "rummelig", "label": "Rummelig" }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "cns_anchor",
      "label": "Anker",
      "info": "Bruges til at linke hertil fra menuen.",
      "default": "cns-klubben"
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "hour",
      "label": "Klokkeslæt",
      "default": "05.55"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Du skal ikke stå med det hele alene"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Brødtekst",
      "default": "<p>Én konto rummer altid en bruger mere, uden at det koster ekstra. Din partner får sin egen adgang på sin egen telefon og kan følge søvnlog, kalender og tigerspring med dig.</p><p>Så er det ikke længere dig, der skal huske det hele og fortælle det videre.</p>"
    },
    {
      "type": "header",
      "content": "Stjernerne"
    },
    {
      "type": "paragraph",
      "content": "Himlen åbner sig lige før solopgangen. Stjernerne er stærkest i bunden, dér hvor solopgangen begynder."
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Vis stjernerne",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "min": 0,
      "max": 120,
      "step": 2,
      "label": "Antal stjerner",
      "default": 56
    },
    {
      "type": "range",
      "id": "star_dim",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Styrke",
      "default": 90
    },
    {
      "type": "range",
      "id": "star_halo",
      "min": 40,
      "max": 150,
      "step": 2,
      "unit": "%",
      "label": "Skær",
      "info": "Mindre skær lægger stjernen længere bagud i billedet.",
      "default": 82
    },
    {
      "type": "range",
      "id": "star_spread",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Hvor langt ned stjernerne når",
      "default": 98
    },
    {
      "type": "select",
      "id": "star_mask",
      "label": "Maskens retning",
      "options": [
        { "value": "rise", "label": "Toner ind mod bunden" },
        { "value": "fade", "label": "Toner ud mod bunden" },
        { "value": "ingen", "label": "Ingen maske" }
      ],
      "default": "rise"
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Navn",
          "default": "Sara"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Rolle",
          "default": "Dig"
        },
        {
          "type": "text",
          "id": "status",
          "label": "Mærkat",
          "default": "Aktiv"
        },
        {
          "type": "text",
          "id": "initial",
          "label": "Bogstav i cirklen",
          "info": "Tomt felt bruger navnets første bogstav."
        }
      ]
    },
    {
      "type": "invite",
      "name": "Invitér-linje",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tekst",
          "default": "Invitér partner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CNS partner",
      "blocks": [
        { "type": "person", "settings": { "name": "Sara", "role": "Dig", "status": "Aktiv" } },
        { "type": "person", "settings": { "name": "Nicolaj", "role": "Partner", "status": "Aktiv" } },
        { "type": "invite" }
      ]
    }
  ]
}
{% endschema %}
