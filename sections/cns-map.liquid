{%- comment -%}
  Club No Sleep — et lys i mørket.
  Tekst til venstre, Danmarkskortet til højre. Kortet tegnes på canvas og
  kan skiftes ud med et billede.
{%- endcomment -%}

{% render 'cns-palette', id: section.id, bg: section.settings.cns_bg %}

<section
  id="cns-{{ section.id }}"
  class="cns cns-section cns-space--{{ section.settings.cns_space }} cns-map cns-bg--{{ section.settings.cns_bg }}"
>
  {%- if section.settings.cns_anchor != blank -%}
    <span class="cns-anchor" id="{{ section.settings.cns_anchor | handle }}"></span>
  {%- endif -%}

  <div class="cns-wrap">
    {%- if section.settings.hour != blank -%}
      <p class="cns-hour">{{ section.settings.hour }}</p>
    {%- endif -%}

    <div class="cns-maprow">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="cns-lede cns-rte cns-body">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      <div class="cns-mapbox">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', sizes: '(min-width: 820px) 480px, 92vw', widths: '400, 600, 900', alt: ''
          }}
        {%- else -%}
          <canvas class="cns-map__canvas" data-cns-canvas="denmark" aria-hidden="true"></canvas>
        {%- endif -%}

        {%- if section.settings.count != blank -%}
          <p class="cns-count">{{ section.settings.count }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.image == blank -%}
  <script src="{{ 'cns-lights.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "CNS lyskort",
  "tag": "section",
  "class": "cns-map-section",
  "settings": [
    {
      "type": "select",
      "id": "cns_bg",
      "label": "Baggrund",
      "options": [
        { "value": "nat", "label": "Nat" },
        { "value": "dyb-nat", "label": "Dyb nat" },
        { "value": "morgen", "label": "Morgen" },
        { "value": "lys-morgen", "label": "Lys morgen" }
      ],
      "default": "nat"
    },
    {
      "type": "select",
      "id": "cns_space",
      "label": "Afstand foroven og forneden",
      "options": [
        { "value": "kompakt", "label": "Kompakt" },
        { "value": "standard", "label": "Standard" },
        { "value": "rummelig", "label": "Rummelig" }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "cns_anchor",
      "label": "Anker",
      "info": "Bruges til at linke hertil fra menuen."
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "hour",
      "label": "Klokkeslæt",
      "default": "03.41"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Et lys i mørket"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Brødtekst",
      "default": "<p>Når du starter en søvnlog, tændes dit lys på kortet. Andre vågne mødre ser det, og du ser deres. Ikke navne, ikke adresser — bare lys.</p><p>Vil du skrive til en af dem, kan du det. Vil du bare vide, at de er der, er det også nok. De fleste nætter er det nok.</p>"
    },
    {
      "type": "header",
      "content": "Kortet"
    },
    {
      "type": "inline_richtext",
      "id": "count",
      "label": "Tæller over kortet",
      "info": "Tallet står fedt: <b>7</b> vågne i Danmark.",
      "default": "<b>7</b> vågne i Danmark"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede i stedet for det tegnede kort",
      "info": "Uden billede tegnes kortet med lys, der blinker."
    }
  ],
  "presets": [
    {
      "name": "CNS lyskort"
    }
  ]
}
{% endschema %}
