{%- comment -%}
  Side B — header. Lys og enkel, i modsætning til forsidens mørke.
  Ligger inde i skabelonen og ikke i headergruppen, fordi den kun hører
  til denne ene side.
{%- endcomment -%}

{%- liquid
  assign ios = settings.cns_app_store_url | default: 'https://apps.apple.com/app/id6764388095'
  assign android = settings.cns_google_play_url | default: 'https://play.google.com/store/apps/details?id=com.base699f47a86e7e0a874d1159ed.app'
-%}

<div class="cnsb cnsb-header">
  <div class="cnsb-wrap cnsb-header__row">
    <a class="cnsb-header__brand" href="/">{{ section.settings.brand }}</a>

    {%- if section.blocks.size > 0 -%}
      <nav class="cnsb-header__nav">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a
        class="cnsb-btn cnsb-header__cta"
        href="{{ ios }}"
        data-cns-store-link
        data-cns-ios="{{ ios }}"
        data-cns-android="{{ android }}"
        data-cns-scroll-to="{{ section.settings.scroll_to | handle }}"
        data-cns-placering="b-header"
      >{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'cns-store.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "B — header",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "brand", "label": "Navn", "default": "Club No Sleep" },
    { "type": "text", "id": "cta_label", "label": "Knappens tekst", "default": "Hent appen" },
    { "type": "text", "id": "scroll_to", "label": "Rul til", "info": "Ankerets navn, hvis besøgende er på en computer.", "default": "b-pris" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "menu_link",
      "name": "Menupunkt",
      "settings": [
        { "type": "text", "id": "label", "label": "Tekst" },
        { "type": "text", "id": "url", "label": "Adresse" }
      ]
    }
  ],
  "presets": [{ "name": "B — header" }]
}
{% endschema %}
